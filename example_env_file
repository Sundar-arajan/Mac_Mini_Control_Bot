# Telegram bot token from BotFather
BOT_TOKEN="TOKEN"

# Comma-separated numeric Telegram user IDs allowed to control the Mac Mini
ALLOWED_TELEGRAM_IDS=123456789

BOT_NAME=Mac Mini Control Bot
SERVICE_LABEL=com.macmini.controlbot

# Emergency disable switches
BOT_ENABLED=true
STATUS_FEATURES_ENABLED=true
CONTROL_ACTIONS_ENABLED=true
SCREENSHOT_ENABLED=true
ALERTS_ENABLED=true
DISK_HEALTH_ENABLED=true

# Public IP check uses https://api.ipify.org
ENABLE_PUBLIC_IP=true

# Alert checks
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=30

# Quiet hours suppress non-critical alerts
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=23:00
QUIET_HOURS_END=07:00

# Resource alerts
HIGH_CPU_PERCENT=90
HIGH_CPU_CONSECUTIVE_CHECKS=5
HIGH_RAM_PERCENT=90
DISK_ALERT_PERCENTAGES=85,90,95
LOWER_RESET_MARGIN_PERCENT=10

# Alert types
MONITOR_ALL_VOLUMES=true
ENABLE_VOLUME_ALERTS=true
ENABLE_INTERNET_ALERTS=true
ENABLE_LOCK_UNLOCK_ALERTS=true
ENABLE_LOGIN_LOGOUT_ALERTS=true

# Network usage sample duration when pressing Network Speed
NETWORK_SPEED_SAMPLE_SECONDS=2

# Daily report
ENABLE_DAILY_REPORT=true
DAILY_REPORT_TIME=09:00

# Screenshot cleanup
SCREENSHOT_KEEP_LAST=10

# Rate limits
RATE_LIMIT_GENERAL_PER_MINUTE=30
RATE_LIMIT_CONTROL_PER_MINUTE=5
RATE_LIMIT_SCREENSHOT_PER_MINUTE=3
RATE_LIMIT_RESTART_SHUTDOWN_PER_2MIN=1

# Bot log rotation
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
